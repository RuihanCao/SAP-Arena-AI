{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sap-arena.local/schemas/play_web_game_v1.json",
  "title": "SAP-Arena play-web duel archive v1",
  "type": "object",
  "required": [
    "schema_version", "id", "created_at", "updated_at", "git_sha",
    "ai_version", "seeds", "rules", "turns", "done", "winner",
    "end_reason", "final"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "ai_version": {"$ref": "#/$defs/ai_version"},
    "seeds": {
      "type": "object",
      "required": ["game", "human", "ai", "battle"],
      "properties": {
        "game": {"type": "integer"},
        "human": {"type": "integer"},
        "ai": {"type": "integer"},
        "battle": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "object",
      "required": ["name", "game_mode", "start_lives", "max_lives", "turn_cap"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "game_mode": {"type": "string", "minLength": 1},
        "start_lives": {"type": "integer", "minimum": 1},
        "max_lives": {"type": ["integer", "null"], "minimum": 1},
        "turn_cap": {"type": "integer", "minimum": 1}
      }
    },
    "gear_start": {"type": "object"},
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "turn", "ok", "error", "ai_ok", "ai_error", "banner",
          "n_segments", "searched_segments", "greedy_segments", "segments",
          "elapsed_ms", "stop_latency_ms", "end_to_result_ms", "gear",
          "finish_turn", "chunk_size", "search_used", "search_error",
          "segments_capped", "ai_actions", "human", "ai"
        ],
        "properties": {
          "turn": {"type": "integer", "minimum": 1},
          "ok": {"type": "boolean"},
          "error": {"type": ["string", "null"]},
          "ai_ok": {"type": "boolean"},
          "ai_error": {"type": ["string", "null"]},
          "banner": {"type": ["string", "null"]},
          "n_segments": {"type": "integer", "minimum": 0},
          "searched_segments": {"type": "integer", "minimum": 0},
          "greedy_segments": {"type": "integer", "minimum": 0},
          "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}},
          "elapsed_ms": {"type": "integer", "minimum": 0},
          "stop_latency_ms": {"type": "integer", "minimum": 0},
          "end_to_result_ms": {"type": "integer", "minimum": 0},
          "gear": {"type": "string", "minLength": 1},
          "finish_turn": {"type": "boolean"},
          "chunk_size": {"type": "integer", "minimum": 1},
          "search_used": {"type": "boolean"},
          "search_error": {"type": ["string", "null"]},
          "segments_capped": {"type": "boolean"},
          "ai_actions": {"type": "array", "items": {"type": "string"}},
          "human": {"$ref": "#/$defs/side"},
          "ai": {"$ref": "#/$defs/side"},
          "outcome": {"enum": ["win", "loss", "draw"]},
          "ai_outcome": {"enum": ["win", "loss", "draw"]},
          "life_bonus_applied": {"type": "boolean"},
          "lives": {
            "type": "object",
            "required": ["human", "ai"],
            "properties": {
              "human": {"type": "integer", "minimum": 0},
              "ai": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },
          "human_board": {"type": "array"},
          "ai_board": {"type": "array"},
          "render_job": {"$ref": "#/$defs/render_job"},
          "render": {
            "type": "object",
            "required": ["path", "bytes", "calculator_link"],
            "properties": {
              "path": {"type": "string", "pattern": "^turn-[0-9]{3}\\.png$"},
              "bytes": {"type": "integer", "minimum": 1},
              "calculator_link": {"type": ["string", "null"]}
            }
          }
        },
        "allOf": [{
          "if": {"properties": {"ok": {"const": true}}, "required": ["ok"]},
          "then": {
            "required": [
              "outcome", "ai_outcome", "life_bonus_applied", "lives",
              "human_board", "ai_board", "render_job"
            ]
          }
        }]
      }
    },
    "final": {
      "type": "object",
      "required": ["human", "ai"],
      "properties": {
        "human": {"$ref": "#/$defs/final_side"},
        "ai": {"$ref": "#/$defs/final_side"}
      }
    },
    "done": {"type": "boolean"},
    "winner": {"enum": ["human", "ai", null]},
    "end_reason": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "string",
          "pattern": "^(both_lives_0|human_lives_0|ai_lives_0|turn_cap|ai_failed|end_turn_failed:.+)$"
        }
      ]
    }
  },
  "$defs": {
    "render_job": {
      "type": "object",
      "required": ["rows", "max_lives", "calc_config"],
      "properties": {
        "rows": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/render_row"}
        },
        "max_lives": {"type": "integer", "minimum": 1},
        "calc_config": {
          "type": "object",
          "required": [
            "playerPack", "opponentPack", "turn",
            "playerPets", "opponentPets"
          ],
          "properties": {
            "playerPack": {"type": "string", "minLength": 1},
            "opponentPack": {"type": "string", "minLength": 1},
            "turn": {"type": "integer", "minimum": 1},
            "playerPets": {"type": "array"},
            "opponentPets": {"type": "array"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "required": [
        "index", "mode", "width", "chunks", "ms", "boundary_reason",
        "committed_types", "committed_stochastic_reasons", "search_used",
        "search_error", "n_dedup"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "mode": {"enum": ["searched", "greedy"]},
        "width": {"type": "integer", "minimum": 1},
        "chunks": {"type": "integer", "minimum": 0},
        "ms": {"type": "integer", "minimum": 0},
        "boundary_reason": {"type": ["string", "null"]},
        "committed_types": {"type": "array", "items": {"type": "string"}},
        "committed_stochastic_reasons": {
          "type": "array", "items": {"type": ["string", "null"]}
        },
        "search_used": {"type": "boolean"},
        "search_error": {"type": ["string", "null"]},
        "n_dedup": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "render_row": {
      "type": "object",
      "required": [
        "turn", "outcome", "opponentName", "playerPets", "opponentPets"
      ],
      "properties": {
        "turn": {"type": "integer", "minimum": 1},
        "outcome": {"enum": ["win", "loss", "draw"]},
        "opponentName": {"const": "AI"},
        "playerPets": {"type": "array"},
        "opponentPets": {"type": "array"}
      },
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "ai_version": {
      "type": "object",
      "required": [
        "agent", "bc_checkpoint", "vgame_heads", "vgame_extractor",
        "search", "turn_mode", "stochastic_samples", "imagination_key",
        "torch_threads", "skip_imagined_validation",
        "honest_driver_commit", "git_sha"
      ],
      "properties": {
        "agent": {"type": "string", "minLength": 1},
        "bc_checkpoint": {"$ref": "#/$defs/checkpoint"},
        "vgame_heads": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/checkpoint"}
        },
        "vgame_extractor": {"$ref": "#/$defs/checkpoint"},
        "search": {
          "type": "object",
          "required": [
            "scoring", "width", "ksim", "max_turn", "seed",
            "blend", "pessimism"
          ],
          "properties": {
            "scoring": {"const": "vgame"},
            "width": {"type": "integer", "minimum": 1},
            "ksim": {"type": "integer", "minimum": 1},
            "max_turn": {"type": "integer", "minimum": 1},
            "seed": {"type": "integer"},
            "blend": {"type": "number"},
            "pessimism": {"type": "number"}
          },
          "additionalProperties": false
        },
        "turn_mode": {"const": "segmented-honest"},
        "stochastic_samples": {"type": "integer", "minimum": 1},
        "imagination_key": {
          "const": "sha256(engine_seed, turn, segment_index, sample_r)"
        },
        "torch_threads": {"type": "integer", "minimum": 1},
        "skip_imagined_validation": {"type": "boolean"},
        "honest_driver_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    },
    "final_side": {
      "type": "object",
      "required": ["lives", "wins", "losses", "draws"],
      "properties": {
        "lives": {"type": "integer", "minimum": 0},
        "wins": {"type": "integer", "minimum": 0},
        "losses": {"type": "integer", "minimum": 0},
        "draws": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "side": {
      "type": "object",
      "required": ["state_before", "actions", "action_text", "diverged_at"],
      "properties": {
        "state_before": {"$ref": "#/$defs/archive_state"},
        "actions": {"type": "array", "items": {"type": "object"}},
        "action_text": {"type": "array", "items": {"type": "string"}},
        "diverged_at": {"type": ["string", "null"]},
        "board_pre_battle": {"type": "array"}
      }
    },
    "archive_state": {
      "type": "object",
      "required": [
        "pack", "turn", "gold", "lives", "trophies", "team", "shop", "meta"
      ],
      "properties": {
        "pack": {"const": "Turtle"},
        "turn": {"type": "integer", "minimum": 1, "maximum": 50},
        "gold": {"type": "integer", "minimum": 0, "maximum": 99},
        "lives": {"type": "integer", "minimum": 0, "maximum": 6},
        "trophies": {"type": "integer", "minimum": 0, "maximum": 10},
        "team": {
          "type": "array", "minItems": 5, "maxItems": 5,
          "items": {"$ref": "#/$defs/team_slot"}
        },
        "shop": {
          "type": "array", "minItems": 0, "maxItems": 9,
          "items": {"$ref": "#/$defs/shop_slot"}
        },
        "meta": {
          "type": "object",
          "required": ["seed_known", "source", "version"],
          "properties": {
            "seed_known": {"type": "boolean"},
            "source": {"type": "string"},
            "version": {"const": "v1"},
            "seed": {"type": ["integer", "null"]},
            "oracle": {"type": "object"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "team_slot": {
      "type": "object",
      "required": [
        "slot_index", "pet_id", "attack", "health", "level", "exp",
        "equipment_id", "status_effects"
      ],
      "properties": {
        "slot_index": {"type": "integer", "minimum": 0, "maximum": 4},
        "pet_id": {"type": ["string", "null"]},
        "attack": {"type": "integer", "minimum": 0, "maximum": 50},
        "health": {"type": "integer", "minimum": 0, "maximum": 50},
        "perm_attack": {"type": "integer", "minimum": 0, "maximum": 50},
        "perm_health": {"type": "integer", "minimum": 0, "maximum": 50},
        "temp_attack": {"type": "integer", "minimum": 0, "maximum": 50},
        "temp_health": {"type": "integer", "minimum": 0, "maximum": 50},
        "sell_value": {"type": "integer", "minimum": 0, "maximum": 50},
        "level": {"type": "integer", "minimum": 1, "maximum": 3},
        "exp": {"type": "integer", "minimum": 0, "maximum": 5},
        "equipment_id": {"type": ["string", "null"]},
        "status_effects": {
          "type": "array", "items": {"type": "string"}, "maxItems": 8
        }
      },
      "additionalProperties": false
    },
    "shop_slot": {
      "type": "object",
      "required": ["shop_index", "slot_type", "item_id", "cost", "frozen"],
      "properties": {
        "shop_index": {"type": "integer", "minimum": 0, "maximum": 8},
        "slot_type": {"enum": ["pet", "food"]},
        "item_id": {"type": "string"},
        "attack": {"type": "integer", "minimum": 0, "maximum": 50},
        "health": {"type": "integer", "minimum": 0, "maximum": 50},
        "at": {"type": "integer", "minimum": 0, "maximum": 50},
        "hp": {"type": "integer", "minimum": 0, "maximum": 50},
        "cost": {"type": "integer", "minimum": 0, "maximum": 3},
        "frozen": {"type": "boolean"},
        "link_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  }
}
